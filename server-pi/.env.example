# Copy this file to `.env` and fill with real values (DO NOT commit `.env`).
# Example .env for nexus-docker

# MariaDB credentials
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=edi_project
MYSQL_USER=replace_with_db_user
MYSQL_PASSWORD=replace_with_strong_password

# Optional: host and charset overrides (defaults used if unset)
MYSQL_HOST=db
MYSQL_CHARSET=utf8mb4

# Dashboard backend
# NEXUS_PROM_URL=http://prometheus:9090
# NEXUS_BIND_HOST=0.0.0.0
# NEXUS_BIND_PORT=8081


